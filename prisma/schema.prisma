generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  TRAINER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student Student?
}

model Student {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  matricNumber String   @unique
  fullName     String
  level        Int
  createdAt    DateTime @default(now())

  applications Application[]
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Skill {
  id           String        @id @default(cuid())
  name         String        @unique
  category     String
  applications Application[]
}

model Application {
  id        String            @id @default(cuid())
  studentId String
  student   Student           @relation(fields: [studentId], references: [id])
  skillId   String
  skill     Skill             @relation(fields: [skillId], references: [id])
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  payments           Payment[]
  trainingAssignment TrainingAssignment?
}

enum PaymentType {
  SIWES_REGISTRATION
  VOCATIONAL_TRAINING
  EXAMINATION
}

model Payment {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id])
  type          PaymentType
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  providerRef   String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([applicationId, type])
}

model Trainer {
  id        String   @id @default(cuid())
  fullName  String
  email     String   @unique
  specialty String
  createdAt DateTime @default(now())

  assignments TrainingAssignment[]
}

enum TrainingStatus {
  NOT_ASSIGNED
  ASSIGNED
  ACTIVE
  COMPLETED
}

model TrainingAssignment {
  id            String         @id @default(cuid())
  applicationId String         @unique
  application   Application    @relation(fields: [applicationId], references: [id])
  trainerId     String
  trainer       Trainer        @relation(fields: [trainerId], references: [id])
  status        TrainingStatus @default(NOT_ASSIGNED)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())

  project Project?
}

model Project {
  id                   String             @id @default(cuid())
  trainingAssignmentId String             @unique
  trainingAssignment   TrainingAssignment @relation(fields: [trainingAssignmentId], references: [id])
  title                String?
  submissionUrl        String?
  submittedAt          DateTime?
  reviewed             Boolean            @default(false)

  exam Exam?
}

model Exam {
  id        String    @id @default(cuid())
  projectId String    @unique
  project   Project   @relation(fields: [projectId], references: [id])
  mode      String    @default("PHYSICAL")
  score     Int?
  takenAt   DateTime?

  result Result?
}

model Result {
  id          String   @id @default(cuid())
  examId      String   @unique
  exam        Exam     @relation(fields: [examId], references: [id])
  finalScore  Int
  passed      Boolean
  publishedAt DateTime @default(now())
}
