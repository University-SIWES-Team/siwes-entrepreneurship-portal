generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
  TRAINER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum SessionType {
  PHYSICAL
  VIRTUAL
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PENDING_REVIEW
  PAID
  FAILED
}

enum PaymentMethod {
  MANUAL
  ONLINE
}

enum PaymentType {
  SIWES_REGISTRATION
  VOCATIONAL_TRAINING
  EXAMINATION
}

enum TrainingStatus {
  NOT_ASSIGNED
  ASSIGNED
  ACTIVE
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student      Student?
  trainer      Trainer?
  resetTokens  PasswordResetToken[]
}

model Student {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  matricNumber String   @unique
  fullName     String
  level        Int
  createdAt    DateTime @default(now())

  applications Application[]
}

model Skill {
  id           String        @id @default(cuid())
  name         String        @unique
  category     String
  applications Application[]
}

model Application {
  id                 String              @id @default(cuid())
  studentId          String
  student            Student             @relation(fields: [studentId], references: [id])
  skillId            String
  skill              Skill               @relation(fields: [skillId], references: [id])
  status             ApplicationStatus   @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  payments           Payment[]
  trainingAssignment TrainingAssignment?
}

model Payment {
  id               String        @id @default(cuid())
  applicationId    String
  amount           Decimal       @db.Decimal(10, 2)
  status           PaymentStatus @default(PENDING)
  method           PaymentMethod @default(MANUAL)
  providerRef      String?       @unique
  manualReference  String?
  paymentDate      DateTime?
  evidencePath     String?
  evidenceName     String?
  evidenceMimeType String?
  evidenceSize     Int?
  submittedAt      DateTime?
  reviewedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  type             PaymentType
  application      Application   @relation(fields: [applicationId], references: [id])

  @@unique([applicationId, type])
}

model Trainer {
  id            String               @id @default(cuid())
  userId        String               @unique
  user          User                 @relation(fields: [userId], references: [id])
  fullName      String
  specialty     String
  createdAt     DateTime             @default(now())

  assignments   TrainingAssignment[]
  classSessions ClassSession[]
}

model TrainingAssignment {
  id            String         @id @default(cuid())
  applicationId String         @unique
  application   Application    @relation(fields: [applicationId], references: [id])
  trainerId     String
  trainer       Trainer        @relation(fields: [trainerId], references: [id])
  status        TrainingStatus @default(NOT_ASSIGNED)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())

  project       Project?
  attendances   Attendance[]
}

model ClassSession {
  id            String       @id @default(cuid())
  trainerId     String
  trainer       Trainer      @relation(fields: [trainerId], references: [id])
  type          SessionType
  isActive      Boolean      @default(true)
  currentCode   String?
  codeExpiresAt DateTime?
  startedAt     DateTime     @default(now())
  endedAt       DateTime?

  attendances   Attendance[]
}

model Attendance {
  id                   String             @id @default(cuid())
  trainingAssignmentId String
  classSessionId       String
  status               AttendanceStatus   @default(PRESENT)
  deviceFingerprint    String?
  pulseChecksPassed    Int?
  pulseChecksTotal     Int?
  remarks              String?
  createdAt            DateTime           @default(now())

  assignment           TrainingAssignment @relation(fields: [trainingAssignmentId], references: [id], onDelete: Cascade)
  session              ClassSession       @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@unique([trainingAssignmentId, classSessionId])
}

model Project {
  id                   String             @id @default(cuid())
  trainingAssignmentId String             @unique
  trainingAssignment   TrainingAssignment @relation(fields: [trainingAssignmentId], references: [id])
  title                String?
  description          String?
  submissionUrl        String?
  submittedAt          DateTime?
  reviewed             Boolean            @default(false)
  feedback             String?

  exam                 Exam?
}

model Exam {
  id        String    @id @default(cuid())
  projectId String    @unique
  project   Project   @relation(fields: [projectId], references: [id])
  mode      String    @default("PHYSICAL")
  score     Int?
  takenAt   DateTime?

  result    Result?
}

model Result {
  id              String   @id @default(cuid())
  examId          String   @unique
  exam            Exam     @relation(fields: [examId], references: [id])

  attendanceScore Float    @default(0)
  projectScore    Float    @default(0)
  examScore       Float    @default(0)
  totalScore      Float    @default(0)

  grade           String   @default("PENDING")
  passed          Boolean  @default(false)
  remarks         String?

  publishedAt     DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}